# ─────────────────────────────────────────────
# letscode — configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Your OpenRouter API key
# Sign up free at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ─────────────────────────────────────────────
# Choose your model — paste one of the lines
# below (or any model from openrouter.ai/models)
# ─────────────────────────────────────────────

# ── Frontier models (paid, best quality) ──────
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_MODEL=google/gemini-2.5-pro

# ── Free open-source models (no cost) ─────────
# OPENROUTER_MODEL=google/gemma-3-27b-it:free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
# OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Default if nothing is set:
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free